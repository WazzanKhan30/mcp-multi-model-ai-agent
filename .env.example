# LLM Provider Selection
# Options: "groq" (default, recommended) or "openrouter"
LLM_PROVIDER=groq

# Groq API key - get free at https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API key - get free at https://openrouter.ai/keys
# (optional, only needed if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Gemini API key - get free at https://aistudio.google.com/apikey
# (optional - Gemini provider is implemented but may require account
# verification with Google; see README for details)
GEMINI_API_KEY=

# GitHub personal access token - get at https://github.com/settings/tokens
# (public repo read-only scope is sufficient)
GITHUB_TOKEN=

# Tavily API key (web search) - get free at https://tavily.com
TAVILY_API_KEY=
